# Copy to `.env.sync` (gitignored). Used only by:
#   docker compose --profile jobs run --rm clearstory-sync
#
# Local `.env` stays on localhost — this file is how the job talks to ts01.
# This WRITES Clearstory CORs into DB_HOST. Do not point at prod unless you mean to.

DB_HOST=ts01.8a.com
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=CHANGE_ME
DB_DATABASE=GoFormzDB
DB_ENCRYPT=false
DB_TRUST_CERT=true
CRONS_ENABLED=false

CLEARSTORY_API_URL=https://web-api.clearstory.build
CLEARSTORY_KEY_ID=CHANGE_ME
CLEARSTORY_SECRET_KEY=CHANGE_ME
CLEARSTORY_SYNC_ENABLED=true

# Refresh local Docker SQL instead of ts01:
# DB_HOST=mssql
# DB_PASSWORD=trucking@2026
